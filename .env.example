# Optional. Copy to .env for local development; never commit .env.
CONTEXTVAULT_DB=contextvault.db
CONTEXTVAULT_STORAGE_DIR=contextvault.files
# Reject uploads above this byte limit before extraction/OCR (default: 20 MiB).
CONTEXTVAULT_MAX_UPLOAD_BYTES=20971520
# Leave empty to use local rule decisions. Never commit a real key.
OPENROUTER_API_KEY=
